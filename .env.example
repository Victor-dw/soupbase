# DeepSeek-compatible OpenAI API for generation and compass.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://www.xictory.xyz/v1
DEEPSEEK_MODEL=deepseek-v4.1-flash
# Vercel Neon integration injects this automatically. Leave empty for local PGlite.
DATABASE_URL=
