# Required in production. Keep credentials out of NEXT_PUBLIC variables.
DATABASE_URL=
APP_ORIGIN=http://localhost:3000
AI_ACCESS_MODE=byok_only
AI_GATEWAY_API_KEY=
JEV_MODEL=typesafe-ai/jev
# false hides web creation and rejects new puzzle uploads.
# true enables private creation/import; sharing links never add to the public catalog.
UPLOADS_ENABLED=true
# Explanation grading can be disabled for a particular deployment.
ENABLE_GUESS=true
# Local tests only; production refuses this mode.
AI_MOCK=false
# Optional actual GitHub repository URL, used for a voluntary Star link.
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/spoonnotfound/soupbase

# Vercel: production initializes/syncs its database by default.
# false skips setup; true explicitly opts an isolated preview database in.
# DATABASE_SETUP=false
