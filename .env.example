# byok_only | site_only | both
AI_ACCESS_MODE=site_only
# Jev — TypeSafe official API. Required for site_only and both. Never commit a real key.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
